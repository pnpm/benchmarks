{
    "name": "benchmarks-of-javascript-package-managers",
    "private": true,
    "type": "module",
    "description": "Benchmarks of JavaScript package managers",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pnpm/benchmarks.git"
    },
    "license": "MIT",
    "scripts": {
        "benchmark": "node ./index.js",
        "report": "node ./index.js --report-only",
        "merge-results": "node ./mergeResults.js",
        "regenerate-svgs": "node ./regenerate-svgs.mjs",
        "test": "node --test latencyProxy.test.mjs"
    },
    "dependencies": {
        "common-tags": "^1.8.2",
        "cross-spawn": "^7.0.3",
        "get-folder-size": "^3.1.0",
        "load-json-file": "^7.0.1",
        "load-yaml-file": "^1.0.0",
        "path-key": "^4.0.0",
        "pretty-bytes": "^6.0.0",
        "pretty-ms": "^7.0.1",
        "rimraf": "^4.0.0",
        "tempy": "^2.0.0",
        "thenify": "^3.3.1",
        "touch": "^3.1.0",
        "write-yaml-file": "^4.2.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.0.0",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "^24.0.0",
            "onFail": "download"
        }
    }
}
