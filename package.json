{
    "name": "benchmarks-of-javascript-package-managers",
    "private": true,
    "type": "module",
    "description": "Benchmarks of JavaScript package managers",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/pnpm/benchmarks.git"
    },
    "license": "MIT",
    "scripts": {
        "benchmark": "node ./index.js",
        "report": "node ./index.js --report-only",
        "merge-results": "node ./mergeResults.js",
        "test": "node --test latencyProxy.test.mjs pnprServer.test.mjs",
        "lint": "eslint .",
        "populate-cache": "node ./populatePnprCache.js"
    },
    "dependencies": {
        "cross-spawn": "^7.0.3",
        "get-folder-size": "^3.1.0",
        "load-yaml-file": "^1.0.0",
        "path-key": "^4.0.0",
        "rimraf": "^4.0.0",
        "tempy": "^2.0.0",
        "touch": "^3.1.0",
        "write-yaml-file": "^4.2.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.12.1",
            "onFail": "download"
        },
        "runtime": {
            "name": "node",
            "version": "^24.0.0",
            "onFail": "download"
        }
    },
    "devDependencies": {
        "@pnpm/eslint-config": "1100.0.2",
        "@types/node": "^24.19.2",
        "eslint": "^10.13.0",
        "eslint-plugin-jest": "^29.17.0",
        "eslint-plugin-regexp": "^3.3.1",
        "typescript": "6.0.3"
    }
}
